# macOS
.DS_Store

# Xcode user state
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint

# Build products
build/
DerivedData/
*.ipa
*.xcarchive
*.dSYM
*.dSYM.zip
*.app

# Swift Package Manager
.build/
.swiftpm/

# Signing material and local configuration
*.cer
*.p12
*.pem
*.key
*.mobileprovision
.env
.env.*
!.env.example

# Local QA artifacts and internal working notes
/*.png
/tasks/
/Tests/
/CONTRIBUTING.md
/SECURITY.md

# CI workflows are required for IPA builds; keep them tracked.
/.github/*
!/.github/workflows/

# Reference dumps are never shipped.
/Payload/

# Temporary files
*.tmp
*.swp
*~
